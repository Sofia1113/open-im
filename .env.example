# 本地服务端
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
DEMO_LOGIN_ENABLED=true

# JWT 签名与会话
# TOKEN_SECRET 是当前签名密钥（至少 32 字符）。
# 轮换步骤：注入 OPENIM_JWT_KEYS_K2=<新密钥> → 把 JWT_ACTIVE_KEY_ID 切到 k2
#           → 等待至少一个 REFRESH_TOKEN_TTL 后移除旧密钥。
TOKEN_SECRET=replace-with-at-least-32-random-characters
JWT_ACTIVE_KEY_ID=k1
# 访问令牌短期有效，设备撤销最迟在这个时长内生效
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
# 刚轮换掉的刷新令牌在此窗口内仍可交换一次，用于容忍多标签页并发和网络重试
REFRESH_GRACE_SECONDS=60

# 数据库
# 本地开发使用 docker compose up -d 启动的 PostgreSQL；
# 生产环境这三个变量没有默认值，必须显式提供。
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/openim
DATABASE_USER=openim
DATABASE_PASSWORD=openim
DATABASE_POOL_SIZE=10

# Worker 扫描间隔（毫秒）
OPENIM_WORKER_RED_PACKET_EXPIRY_INTERVAL=30000
OPENIM_WORKER_CALL_EXPIRY_INTERVAL=15000

# Web 客户端
VITE_API_URL=http://localhost:3001
