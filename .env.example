# 本地服务端
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
DEMO_LOGIN_ENABLED=true

# JWT 签名与会话
TOKEN_SECRET=replace-with-at-least-32-random-characters
JWT_ACTIVE_KEY_ID=k1
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
REFRESH_GRACE_SECONDS=60

# 数据库
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/openim
DATABASE_USER=openim
DATABASE_PASSWORD=openim
DATABASE_POOL_SIZE=10

# Redis（在线状态、分布式限流、跨实例 Pub/Sub 事件扇出）
# 本地开发使用 docker compose up -d 启动的 Redis
REDIS_URL=redis://127.0.0.1:6379

# 实例 ID（可选）。K8s 部署时建议注入 Pod 名称，便于 Pub/Sub 消息追踪与日志关联。
# 不设置则每次启动自动生成，对单实例部署无影响。
INSTANCE_ID=

# 群成员上限。约束的是**扇出成本**而非存储：一条群消息要投递给每个在线成员。
# 调大它不会让系统支持更大的群，只会让扇出成本超出压测过的范围——
# 万人群需要读扩散改写扩散、成员列表分页与消息按需拉取，是另一个量级的设计。
MAX_GROUP_MEMBERS=500

# Web 客户端
VITE_API_URL=http://localhost:3001
