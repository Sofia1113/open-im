<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.openim</groupId>
    <artifactId>open-im-server</artifactId>
    <version>0.1.0</version>
    <name>OpenIM Server</name>
    <description>Spring Boot backend for the OpenIM MVP</description>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Boot BOM 不管理该依赖（它由 Spring Security BOM 提供），需显式声明版本 -->
        <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
        <bucket4j.version>8.19.0</bucket4j.version>
        <jacoco.version>0.8.15</jacoco.version>
        <cyclonedx.version>2.9.2</cyclonedx.version>
        <springdoc.version>2.8.6</springdoc.version>
        <!--
            覆盖率下限。设为当前实际水平略低一点，用于防止回退而不是追求数字：
            阈值定得过高会诱导为覆盖率而写无断言的测试。
            补充测试后应同步上调。
        -->
        <jacoco.line.coverage>0.65</jacoco.line.coverage>
        <jacoco.branch.coverage>0.48</jacoco.branch.coverage>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 可观测性：Prometheus 指标 + 分布式链路上下文。
             即使暂不部署 OTLP collector，tracing bridge 也会把 traceId/spanId
             注入日志，使一次请求在各条日志之间可关联。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <!--
            OTLP span 导出器。
            此前只有 bridge 没有 exporter：traceId/spanId 会生成并注入日志
            （因此一次请求的多条日志能串起来），但 span 从不离开进程——
            无法在任何追踪系统里看到调用链。这个依赖补上导出能力。

            默认不启用：未配置 endpoint 时导出器空转，不产生网络请求。
            见 application.yml 的 management.otlp.tracing。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- 持久化：JdbcClient + HikariCP。
             选择 JDBC 而非 JPA 的原因见 docs/01-architecture/ARCHITECTURE.md：
             红包领取依赖 SELECT ... FOR UPDATE SKIP LOCKED 和条件更新，
             需要对 SQL 与锁行为有精确控制，ORM 的抽象在此处是负担。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- 标准 JWT 签发与验证。用成熟实现替代自研的 HMAC+Base64 拼接，
             以获得 kid 密钥轮换、算法约束和规范的声明校验。 -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- 密码哈希。只取 crypto 模块而非 spring-boot-starter-security：
             后者会自动装配一条 Servlet Filter 链，与本项目已有的
             AuthenticationInterceptor 形成两套并行的鉴权路径——
             两处都能放行请求时，任何一处的疏漏都是漏洞。
             这里只需要 BCryptPasswordEncoder，它不依赖 Spring 上下文。
             版本由 Spring Boot BOM 托管。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 限流。进程内令牌桶（单实例开发用）+ Redis 分布式限流（多实例用）。
             Bucket4j Redis 后端在中国镜像不可用，因此分布式限流
             通过 spring-data-redis 自行实现（Lua 脚本原子计数器），
             调用侧接口不变。 -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <!-- 令牌桶按 key 缓存并自动淘汰，进程内限流降级时使用 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Redis：在线状态、Streams 跨实例扇出、分布式限流、缓存失效广播。
             选择 Lettuce（Spring Boot 默认）而非 Jedis：Lettuce 是非阻塞的，
             在 WebSocket 广播这种高并发写入场景下不会因连接池耗尽而串行化。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            OpenAPI 规范生成。
            此前 API 契约只有手写的 Markdown 文档加一份手写的 TypeScript 类型，
            两者与实现之间没有任何机制保证一致——改了控制器忘了改文档不会有任何提示。
            springdoc 从控制器与 DTO 的实际签名生成规范，因此它不可能与实现漂移。

            版本显式声明：Spring Boot BOM 不管理 springdoc。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成测试使用真实 PostgreSQL，避免 H2 与 PG 的方言/锁语义差异 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Redis 集成测试直接使用 GenericContainer + redis:7-alpine 镜像，
             不依赖 testcontainers:redis 模块（它只是对 GenericContainer 的封装），
             避免引入 Spring Boot BOM 之外的非托管版本。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- SBOM：供应链审计与漏洞比对的基础，版本固定以保证产物可复现 -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.version}</version>
                <configuration>
                    <outputFormat>json</outputFormat>
                    <!-- 只记录实际打进制品的依赖，test 作用域不属于交付物 -->
                    <includeTestScope>false</includeTestScope>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <!-- 纯数据载体与入口类没有可测的分支逻辑，
                                     计入分母只会稀释真实的覆盖情况 -->
                                <exclude>com/openim/server/OpenImApplication.class</exclude>
                                <exclude>com/openim/server/domain/DomainModels*</exclude>
                                <exclude>com/openim/server/domain/DomainResults*</exclude>
                                <exclude>com/openim/server/domain/Requests*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!--
                            固定 Docker API 版本供 Testcontainers 使用。

                            Docker Engine 29 起把 MinAPIVersion 提升到 1.40，而 docker-java 3.4.2
                            默认协商到更低版本，导致 /info 返回 400，Testcontainers 报
                            "Could not find a valid Docker environment"。
                            1.44 同时被 Docker 25+ 和 CI 环境接受。

                            注意必须用系统属性 api.version，而不是 DOCKER_API_VERSION 环境变量：
                            docker-java 的 DefaultDockerClientConfig 只在这个路径读取版本覆盖。
                            升级 Testcontainers 到支持新版协商的版本后可以移除。
                        -->
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
