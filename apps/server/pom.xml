<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.openim</groupId>
    <artifactId>open-im-server</artifactId>
    <version>0.1.0</version>
    <name>OpenIM Server</name>
    <description>Spring Boot backend for the OpenIM MVP</description>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Boot BOM 不管理该依赖（它由 Spring Security BOM 提供），需显式声明版本 -->
        <nimbus-jose-jwt.version>10.3</nimbus-jose-jwt.version>
        <bucket4j.version>8.14.0</bucket4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 持久化：JdbcClient + HikariCP。
             选择 JDBC 而非 JPA 的原因见 docs/01-architecture/ARCHITECTURE.md：
             红包领取依赖 SELECT ... FOR UPDATE SKIP LOCKED 和条件更新，
             需要对 SQL 与锁行为有精确控制，ORM 的抽象在此处是负担。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- 标准 JWT 签发与验证。用成熟实现替代自研的 HMAC+Base64 拼接，
             以获得 kid 密钥轮换、算法约束和规范的声明校验。 -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- 限流。当前使用进程内令牌桶；多实例部署时换成 bucket4j_jdk17-redis
             即可切到分布式配额，业务侧的调用方式不变。 -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <!-- 令牌桶按 key 缓存并自动淘汰，避免长期累积不再活跃的限流键 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成测试使用真实 PostgreSQL，避免 H2 与 PG 的方言/锁语义差异 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!--
                            固定 Docker API 版本供 Testcontainers 使用。

                            Docker Engine 29 起把 MinAPIVersion 提升到 1.40，而 docker-java 3.4.2
                            默认协商到更低版本，导致 /info 返回 400，Testcontainers 报
                            "Could not find a valid Docker environment"。
                            1.44 同时被 Docker 25+ 和 CI 环境接受。

                            注意必须用系统属性 api.version，而不是 DOCKER_API_VERSION 环境变量：
                            docker-java 的 DefaultDockerClientConfig 只在这个路径读取版本覆盖。
                            升级 Testcontainers 到支持新版协商的版本后可以移除。
                        -->
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
